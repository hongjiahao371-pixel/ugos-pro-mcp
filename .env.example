# UGOS Pro MCP Server 连接配置
# 把本文件复制为 .env 并填入你的真实信息（.env 含密码，请勿提交到任何仓库）

# NAS 局域网地址（必填），例如 192.168.1.10
UGOS_HOST=

# 登录账号（必填）
UGOS_USER=

# 登录密码（必填）
UGOS_PASSWORD=

# HTTPS 端口（默认 9443）
UGOS_PORT=9443

# 是否允许写入类工具：1 允许，0 只读模式
UGOS_ALLOW_WRITE=1

# 传输方式：stdio（默认，本机接入）；部署在 NAS Docker 等远程场景改为 sse
UGOS_MCP_TRANSPORT=stdio
# 远程模式的监听地址与端口
UGOS_MCP_HOST=0.0.0.0
UGOS_MCP_PORT=8000
